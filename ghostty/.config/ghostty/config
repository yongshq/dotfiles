theme = Catppuccin Macchiato
font-family = JetBrainsMono Nerd Font
font-size = 14
window-padding-x = 8
window-padding-y = 8

# macos-option-as-alt: which Option key sends Alt/Meta instead of composing
# special characters (˙∆˚¬ é – etc.).
#   left  = LEFT Option acts as Alt (for keybindings like herdr's alt+h/j/k/l
#           pane switching); RIGHT Option still composes special characters.
#   true  = both Option keys act as Alt.   false = neither (macOS default).
macos-option-as-alt = left

# Split (pane) navigation: alt+shift+h/j/k/l. Uses alt+shift so it doesn't
# collide with herdr's prefix-free alt+h/j/k/l pane switching (herdr runs
# inside Ghostty and needs alt+h/j/k/l passed through untouched).
keybind = alt+shift+h=goto_split:left
keybind = alt+shift+j=goto_split:bottom
keybind = alt+shift+k=goto_split:top
keybind = alt+shift+l=goto_split:right

cursor-style = block
cursor-style-blink = true
# Stop Ghostty's shell integration from forcing a bar cursor at the prompt
shell-integration-features = no-cursor
